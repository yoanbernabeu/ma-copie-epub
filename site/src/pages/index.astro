    <dialog id="inapp" class="inapp" aria-labelledby="inapp-title">
      <h2 id="inapp-title">Ouvrez la page dans votre navigateur</h2>
      <p>Le navigateur intégré à cette application (X, Instagram, Facebook…) ne sait pas télécharger de fichiers.</p>
      <p class="inapp-how">
        Touchez le menu <strong>⋮</strong> ou <strong>•••</strong> à côté de l’adresse du site, puis <strong>Ouvrir dans le navigateur</strong>.
      </p>
      <p>L’extension s’installe sur ordinateur. Vous pouvez aussi copier le lien pour l’ouvrir plus tard :</p>
      <div class="inapp-copy">
        <input type="text" readonly value={pageUrl} aria-label="Lien de la page" />
        <button type="button" data-copy>Copier</button>
      </div>
      <form method="dialog">
        <button class="inapp-close">Fermer</button>
      </form>
    </dialog>

    <script>
      // Les navigateurs intégrés aux applications sont des WebViews qui ne
      // téléchargent pas les fichiers : on invite à rouvrir la page ailleurs.
      const ua = navigator.userAgent;
      const isIOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
      const isAndroid = /Android/.test(ua);
      const namedApp = /Twitter|\bX\/\d|FBAN|FBAV|FB_IAB|Instagram|LinkedInApp|\bLine\/|Snapchat|TikTok|musical_ly|BytedanceWebview/i.test(ua);
      const iosWebView = isIOS && !/Safari\//.test(ua);
      const androidWebView = isAndroid && /; wv\)/.test(ua);
      const dialog = document.getElementById("inapp") as HTMLDialogElement | null;

      // « M'envoyer le lien » (téléphone) : partage natif, sinon e-mail pré-rempli
      document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const url = location.href.split("#")[0];
          const title = "Ma copie EPUB, à installer sur ordinateur";
          if (navigator.share) {
            try { await navigator.share({ title, url }); return; } catch { return; }
          }
          location.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`;
        });
      });

      // Boutons « Copier l'adresse » du tutoriel (les liens chrome:// sont bloqués depuis une page web)
      document.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copyText || "");
            btn.textContent = "Adresse copiée ✓";
          } catch {
            btn.textContent = "Sélectionnez et copiez l’adresse";
          }
        });
      });

      if (dialog && (namedApp || iosWebView || androidWebView)) {
        const input = dialog.querySelector("input")!;
        const copyBtn = dialog.querySelector<HTMLButtonElement>("[data-copy]")!;
        copyBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(input.value);
          } catch {
            input.select();
            document.execCommand("copy");
          }
          copyBtn.textContent = "Copié";
        });
        document.querySelectorAll<HTMLAnchorElement>("a.download").forEach((link) => {
          link.addEventListener("click", (event) => {
            event.preventDefault();
            if (typeof dialog.showModal === "function") dialog.showModal();
            else dialog.setAttribute("open", "");
          });
        });
      }
    </script>
  </body>
</html>

