---
import "@fontsource-variable/bricolage-grotesque/standard.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repoUrl = "https://github.com/yoanbernabeu/ma-copie-epub";
const zipUrl = `${repoUrl}/releases/latest/download/ma-copie-epub.zip`;
const releasesUrl = `${repoUrl}/releases/latest`;
const sourceUrl = "https://melenchon2027.fr/programme/livre/";
const paperUrl = "https://ld-es.fr/catalogue/la-dispute/l-avenir-en-commun";
const lawUrl = "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000048603495";
const mentionsUrl = "https://melenchon2027.fr/mentions-legales/";
const ccLicenseUrl = "https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode.fr";
const waybackMentionsUrl = "https://web.archive.org/web/20261107182639/https://melenchon2027.fr/mentions-legales/";
const ccFaqUrl = "https://creativecommons.org/faq/#what-if-i-change-my-mind-about-using-a-cc-license";
// Empreinte du ZIP de la release, fournie par la CI au moment du build
const zipSha256 = process.env.ZIP_SHA256 || "";
const ogImage = new URL(`${base}og.png`, Astro.site ?? new URL("http://localhost:4321")).href;

const site = Astro.site ?? new URL("http://localhost:4321");
const pageUrl = new URL(base, site).href;
const pageTitle = "Ma copie EPUB : votre copie personnelle du programme 2027 pour liseuse";
const description =
  "Extension pour Chrome qui fabrique, dans votre navigateur, une copie EPUB personnelle du programme publié sur melenchon2027.fr. Projet indépendant, copie privée, aucune donnée collectée.";

const downloadIcon = '<path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16"/>';

const icons: Record<string, string> = {
  eink: '<rect x="5" y="2.5" width="14" height="19" rx="2.5"/><path d="M8.5 7h7M8.5 10.5h7M8.5 14h4.5"/>',
  text: '<path d="M4 19 9 5l5 14M5.8 14h6.4M15 19l3-8 3 8M15.9 16.5h4.2"/>',
  audio: '<path d="M4 9v6h4l5 4V5L8 9H4ZM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/>',
  offline: '<path d="M2 8.8a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16.2a5 5 0 0 1 6 0M12 20h.01M3 3l18 18"/>',
  note: '<path d="m14 4 6 6L9 21H3v-6L14 4ZM12 6l6 6"/>',
};

const tones = [
  { bg: "#1f9e6a", fg: "#ffffff" },
  { bg: "#e4312b", fg: "#ffffff" },
  { bg: "#ff9a3c", fg: "#2a1204" },
  { bg: "#7a3fb0", fg: "#ffffff" },
  { bg: "#ff8fa3", fg: "#3a0d18" },
  { bg: "#3b1240", fg: "#ffffff" },
];

const reasons = [
  { icon: "text", title: "Lisible par tout le monde", text: "Taille du texte, police, interlignage, fond sombre : chacun règle la lecture selon sa vue." },
  { icon: "audio", title: "À écouter", text: "La lecture à voix haute et les lecteurs d’écran lisent le texte dans l’ordre et passent de chapitre en chapitre." },
  { icon: "offline", title: "Sans connexion", text: "Une fois le fichier fabriqué, il se lit dans le train, à la campagne ou sans forfait." },
  { icon: "note", title: "À annoter", text: "Surlignez une mesure, prenez des notes, cherchez un mot dans tout le programme." },
];

const can = [
  "Lire les pages publiques de melenchon2027.fr, uniquement quand vous cliquez sur « Générer ».",
  "Inscrire sur votre copie le nom que vous indiquez, avec la date de création.",
  "Enregistrer le fichier EPUB dans votre dossier Téléchargements.",
];
const cannot = [
  "Voir les autres sites que vous visitez, vos onglets ou votre historique.",
  "Lire vos mots de passe, vos e-mails ou vos fichiers.",
  "Envoyer quoi que ce soit à qui que ce soit : aucune donnée ne sort de votre ordinateur.",
];

const extIcon = (cls = "") => `<img class="fig-icon ${cls}" src="${base}favicon.svg" alt="" width="32" height="32" />`;

const win = (body: string, url = "") =>
  `<div class="fig-win"><div class="fig-bar"><span></span><span></span><span></span><i>${url}</i></div><div class="fig-body">${body}</div></div>`;

const install = [
  {
    title: "Téléchargez l’extension",
    text: ["Cliquez sur le bouton <strong>« Télécharger l’extension »</strong> en haut de cette page. Le fichier <strong>ma-copie-epub.zip</strong> arrive dans votre dossier <em>Téléchargements</em>."],
    fig: win(`<div class="fig-file"><span class="fig-zip">ZIP</span><span><b>ma-copie-epub.zip</b><small>Téléchargement terminé</small></span></div>`, "Téléchargements"),
  },
  {
    title: "Décompressez le fichier",
    text: [
      "<strong>Sur Windows</strong> : clic droit sur le fichier, puis <strong>« Extraire tout… »</strong>, puis <strong>« Extraire »</strong>.",
      "<strong>Sur Mac</strong> : double-cliquez simplement sur le fichier.",
      "Vous obtenez un dossier <strong>ma-copie-epub</strong>. Rangez-le dans <em>Documents</em>, par exemple.",
    ],
    tip: "Gardez ce dossier : si vous le supprimez, l’extension disparaît de Chrome.",
    fig: `<div class="fig-unzip"><span class="fig-zip big">ZIP</span><span class="fig-arrow">→</span><span class="fig-folder"><span></span>ma-copie-epub</span></div>`,
  },
  {
    title: "Ouvrez la page des extensions",
    text: ["Copiez l’adresse ci-dessous, collez-la dans la barre d’adresse de Chrome, puis appuyez sur <strong>Entrée</strong>."],
    copy: "chrome://extensions",
    fig: win(`<div class="fig-address"><span class="fig-lock">⌕</span><b>chrome://extensions</b><span class="fig-caret"></span></div><div class="fig-lines"><i></i><i></i><i></i></div>`),
  },
  {
    title: "Activez le « Mode développeur »",
    text: ["En haut à droite de la page, cliquez sur l’interrupteur <strong>« Mode développeur »</strong> pour l’activer. Trois boutons apparaissent en haut à gauche."],
    tip: "Sur Microsoft Edge, cet interrupteur se trouve dans la colonne de gauche.",
    fig: win(`<div class="fig-ext-head"><b>Extensions</b><span class="fig-toggle-wrap hl">Mode développeur <span class="fig-toggle on"></span></span></div><div class="fig-lines"><i></i><i></i></div>`, "chrome://extensions"),
  },
  {
    title: "Chargez le dossier",
    text: [
      "Cliquez sur <strong>« Charger l’extension non empaquetée »</strong>.",
      "Dans la fenêtre qui s’ouvre, choisissez le dossier <strong>ma-copie-epub</strong>, puis <strong>« Sélectionner »</strong>. La carte « Ma copie EPUB » apparaît.",
    ],
    tip: "Si Chrome affiche « Fichier manifeste manquant », ouvrez le dossier ma-copie-epub : il faut choisir celui qui contient le fichier manifest.json.",
    fig: win(`<div class="fig-buttons"><span class="hl">Charger l’extension non empaquetée</span><span>Empaqueter</span><span>Mettre à jour</span></div><div class="fig-card">${extIcon()}<span><b>Ma copie EPUB</b><small>0.1.0</small></span><span class="fig-toggle on"></span></div>`, "chrome://extensions"),
  },
  {
    title: "Épinglez l’extension",
    text: ["En haut à droite de Chrome, cliquez sur l’icône en forme de <strong>pièce de puzzle</strong>, puis sur l’<strong>épingle</strong> à côté de « Ma copie EPUB ». Son icône, <strong>un livre crème sur fond rouge</strong>, reste alors visible à côté de la barre d’adresse."],
    fig: win(`<div class="fig-toolbar"><span class="fig-puzzle hl">🧩</span></div><div class="fig-menu">${extIcon()}<b>Ma copie EPUB</b><span class="fig-pin hl">📌</span></div>`),
  },
  {
    title: "Générez votre EPUB",
    text: [
      "Cliquez sur l’icône de l’extension (<strong>le livre crème sur fond rouge</strong>, en haut à droite), puis sur <strong>« Générer mon EPUB »</strong>. Un onglet s’ouvre.",
      "Indiquez <strong>votre nom</strong> (ou un pseudonyme) : il sera inscrit sur votre copie, il n’est envoyé nulle part. Cliquez à nouveau sur <strong>« Générer mon EPUB »</strong>. Au bout d’une minute environ, le fichier se télécharge.",
    ],
    fig: `<div class="fig-stack">${win(`<div class="fig-toolbar"><span class="fig-puzzle">🧩</span>${extIcon("small hl")}</div><div class="fig-popup"><b>Ma copie EPUB</b><span class="fig-gen">Générer mon EPUB</span></div>`)}<span class="fig-arrow down">↓</span>${win(`<div class="fig-popup"><span class="fig-input">Votre nom : <i>Camille Exemple</i></span><span class="fig-gen hl">Générer mon EPUB</span><span class="fig-file small"><span class="fig-zip">EPUB</span><span><b>programme-2027.epub</b></span></span></div>`, "Ma copie EPUB")}</div>`,
  },
];

const troubles = [
  ["Je ne trouve pas le dossier ma-copie-epub", "Le fichier ZIP a sans doute été ouvert sans être décompressé. Sur Windows, faites un clic droit sur ma-copie-epub.zip, puis « Extraire tout… » : le dossier apparaît à côté du ZIP. Choisissez ce dossier, pas le ZIP."],
  ["Chrome me propose de « désactiver les extensions en mode développeur »", "Ce message peut apparaître au démarrage de Chrome. Cliquez sur la croix pour le fermer : l’extension reste active."],
  ["« Fichier manifeste manquant »", "Vous avez choisi le mauvais dossier. Recommencez l’étape 5 en choisissant le dossier ma-copie-epub qui contient le fichier manifest.json."],
  ["Je ne vois pas l’icône de l’extension", "Elle est rangée sous l’icône en forme de pièce de puzzle. Épinglez-la (étape 6)."],
  ["La génération échoue", "Vérifiez votre connexion et réessayez. Si l’erreur persiste, le site a peut-être changé : installez la dernière version de l’extension."],
  ["Je suis sur téléphone", "Les navigateurs mobiles n’acceptent pas les extensions. Faites la génération sur un ordinateur, puis transférez le fichier sur votre téléphone ou votre liseuse."],
];

const devices = [
  { name: "Kobo, PocketBook, Vivlio", how: "Branchez la liseuse à l’ordinateur et copiez le fichier dans sa mémoire." },
  { name: "Kindle", how: "Envoyez le fichier avec Send to Kindle (site, application ou e-mail) : Amazon le convertit tout seul.", link: "https://www.amazon.fr/sendtokindle" },
  { name: "Ordinateur", how: "Apple Livres sur Mac, Thorium Reader ou Calibre sur Windows et Linux.", link: "https://thorium.edrlab.org/fr/" },
  { name: "Téléphone et tablette", how: "Transférez le fichier, puis ouvrez-le avec Livres (iPhone, iPad), Google Play Livres ou ReadEra (Android)." },
];

const faq = [
  ["Pourquoi ne pas proposer directement le fichier EPUB ?",
    "Parce que le texte n’est pas sous licence libre : le diffuser demanderait l’autorisation de ses auteurs. Ce projet distribue uniquement un outil, et chacun fabrique sa propre copie."],
  ["Qu’est-ce que la comparaison avec la version du 9 novembre ?",
    "Pendant la génération, l’extension compare le texte récupéré avec celui que le site publiait le 9 novembre 2026, alors sous licence Creative Commons BY-NC-SA 4.0. Elle n’utilise pour cela que des empreintes numériques, qui ne contiennent aucun extrait du texte. Le résultat est affiché à titre d’information : il ne change rien à l’usage du fichier, qui reste une copie privée, à ne pas rediffuser."],
  ["Est-ce une extension officielle ?",
    "Non. C’est un projet indépendant, sans lien avec La France insoumise. Son code est public et sous licence MIT."],
  ["Le texte est-il modifié ?",
    "Non. Seule la mise en forme change : couverture typographique, page de garde, table des matières. Aucune phrase n’est ajoutée, retirée ou réécrite."],
  ["Pourquoi le « Mode développeur » ?",
    "L’extension n’est pas publiée sur le Chrome Web Store : elle s’installe directement depuis GitHub, ce qui passe par ce mode. Il sert uniquement à charger une extension depuis un dossier de votre ordinateur."],
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Ma copie EPUB",
      applicationCategory: "BrowserApplication",
      operatingSystem: "Chrome, Edge, Brave, Vivaldi, Opera",
      description,
      url: pageUrl,
      downloadUrl: zipUrl,
      license: "https://opensource.org/licenses/MIT",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
    },
  ],
};
---

<!doctype html>
<html lang="fr" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#dc2b25" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ma copie EPUB" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ma copie EPUB : votre copie privée du programme 2027, pour liseuse. Projet indépendant." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Détection précoce (avant l'affichage) : téléphone ou navigateur sans extensions Chrome
      (function () {
        var ua = navigator.userAgent, d = document.documentElement;
        var mobile = /Android|iPhone|iPad|iPod|Mobile/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        var chromium = /Chrome\/|Chromium\/|Edg\/|OPR\//.test(ua);
        d.dataset.device = mobile ? "mobile" : "desktop";
        if (!mobile && !chromium) d.dataset.browser = "unsupported";
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="topbar">
      <div class="wrap topbar-inner">
        <span class="topbar-intro">Le programme se lit gratuitement sur le site officiel :</span>
        <a href={sourceUrl}><span class="long">melenchon2027.fr</span><span class="short">Site officiel</span></a>
        <span class="topbar-sep" aria-hidden="true">·</span>
        <a href={paperUrl}><span class="long">Acheter le livre (4,90 €, Éditions La Dispute)</span><span class="short">Acheter le livre · 4,90 €</span></a>
      </div>
    </div>
    <header class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="tag">Projet indépendant · copie privée<span class="tag-more"> prévue par la loi</span></p>
          <h1>Ma copie<br />EPUB</h1>
          <p class="lede">
            Une extension pour Chrome qui fabrique, dans votre navigateur, votre copie personnelle du programme publié
            sur melenchon2027.fr. À lire sur liseuse, hors connexion, à annoter ou à écouter.
          </p>
          <div class="cta cta-desktop">
            <a class="download" href={zipUrl}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={downloadIcon} />
              Télécharger l’extension
            </a>
            <p class="cta-meta">Gratuit, open source, sans compte<br />Chrome, Edge, Brave, Vivaldi, Opera</p>
          </div>
          <p class="cta-warn">
            Vous utilisez un navigateur qui n’accepte pas cette extension (Firefox, Safari…). Ouvrez cette page avec{" "}
            <a href="https://www.google.com/chrome/">Chrome</a> ou <a href="https://www.microsoft.com/edge">Edge</a>.
          </p>
          <div class="cta-mobile">
            <p class="cta-mobile-title">À faire sur un ordinateur</p>
            <p>L’extension s’installe sur Chrome, Edge ou Brave, sur ordinateur. Envoyez-vous le lien pour plus tard :</p>
            <button type="button" class="download" data-share>M’envoyer le lien</button>
          </div>
          <p class="hero-links">
            <a href="#cadre-legal">Le cadre légal</a>
            <a href="#installer">Le guide d’installation</a>
          </p>
        </div>
        <div class="mock-wrap" aria-hidden="true">
          <div class="mock">
            <div class="mock-bar"><span></span><span></span><span></span><i></i></div>
            <div class="mock-popup">
              <p class="mock-title">Ma copie EPUB</p>
              <p class="mock-notice"><b>Copie privée</b>Pour votre usage personnel uniquement.</p>
              <p class="mock-btn">Générer mon EPUB</p>
              <div class="mock-progress"><span></span></div>
              <p class="mock-small">Page 18 / 30</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section class="section legal-top" aria-labelledby="cadre-legal">
        <div class="wrap">
          <p class="eyebrow">Le cadre légal, en clair</p>
          <h2 id="cadre-legal">Une copie privée, faite par vous, pour vous</h2>
          <p class="intro">
            Le texte du programme est protégé par le droit d’auteur. Ce projet ne le reproduit pas et ne le diffuse pas : il vous
            fournit un outil pour exercer un droit que la loi vous reconnaît, la copie privée.
          </p>

          <blockquote class="law">
            <p>
              « Lorsque l’œuvre a été divulguée, l’auteur ne peut interdire : […] 2° Les copies ou reproductions réalisées à
              partir d’une source licite et strictement réservées à l’usage privé du copiste et non destinées à une utilisation
              collective […] »
            </p>
            <footer>
              Article L122-5 du Code de la propriété intellectuelle —
              <a href={lawUrl}>lire l’article sur Légifrance</a>
            </footer>
          </blockquote>

          <ol class="legal-grid">
            <li>
              <h3>Une source licite</h3>
              <p>
                Le texte est lu uniquement sur le site officiel, <a href={sourceUrl}>melenchon2027.fr</a>, tel qu’il est publié
                pour tous. Les <a href={mentionsUrl}>mentions légales du site</a> réservent sa reproduction sous réserve des
                exceptions prévues par la loi, dont la copie privée.
              </p>
            </li>
            <li>
              <h3>C’est vous qui copiez</h3>
              <p>
                La copie est réalisée par votre navigateur, sur votre ordinateur, à votre demande. Aucun serveur intermédiaire,
                aucun stockage : le projet ne copie rien et n’a jamais accès à votre fichier.
              </p>
            </li>
            <li>
              <h3>Strictement privé</h3>
              <p>
                Le fichier est réservé à votre usage personnel : il porte votre nom (ou un pseudonyme) et sa date de création.
                Le partager, l’envoyer, le publier ou le mettre en ligne sort du cadre de la copie privée. Pour faire découvrir
                le programme, partagez le lien du site officiel.
              </p>
            </li>
            <li>
              <h3>Aucun contournement</h3>
              <p>
                L’extension lit seulement ce que voit n’importe quel visiteur : aucune protection technique, aucun accès réservé,
                aucun compte. Elle respecte le site en lisant une page par seconde.
              </p>
            </li>
          </ol>

          <ul class="legal-facts">
            <li>Ce dépôt et cette page ne contiennent <strong>aucun extrait</strong> du programme.</li>
            <li><strong>Projet indépendant</strong>, sans lien avec La France insoumise ni avec son éditeur.</li>
            <li><strong>Aucune donnée collectée</strong> : ni compte, ni statistiques, ni publicité.</li>
            <li>Le livre papier est en vente aux <a href={paperUrl}>Éditions La Dispute</a> (4,90 €).</li>
          </ul>
          <details class="legal-note">
            <summary>Une précision sur la licence d’origine du texte</summary>
            <p>
              Jusqu’au 10 novembre 2026, ce texte était publié sur le site sous licence{" "}
              <a href={ccLicenseUrl}>Creative Commons BY-NC-SA 4.0</a>, une licence que Creative Commons déclare{" "}
              <a href={ccFaqUrl}>irrévocable</a> (voir les{" "}
              <a href={waybackMentionsUrl}>mentions légales du site au 7 novembre 2026</a>, archivées par la Wayback
              Machine). Pendant la génération, l’extension vérifie, à l’aide d’empreintes
              numériques qui ne contiennent aucun extrait, si le texte récupéré est identique à cette version, et affiche
              le résultat. Cette information complète le cadre de la copie privée sans le remplacer : le fichier reste
              réservé à votre usage personnel.
            </p>
          </details>
          <p class="disclaimer">
            Ces informations présentent le fondement juridique du projet ; elles ne constituent pas un conseil juridique
            personnalisé.
          </p>
        </div>
      </section>
      <section class="section" aria-labelledby="pourquoi">
        <div class="wrap">
          <h2 id="pourquoi">Pourquoi un EPUB ?</h2>
          <p class="intro">
            Sur le site, le programme est découpé en une trentaine de pages web à lire en ligne. En EPUB, il tient dans un seul
            fichier qui s’adapte à vous.
          </p>
          <ul class="steps">
            {reasons.map((s, i) => (
              <li style={`--tone:${tones[i % tones.length].bg};--tone-fg:${tones[i % tones.length].fg}`}>
                <span class="step-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.icon]} /></span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section-tint" aria-labelledby="installer">
        <div class="wrap">
          <h2 id="installer">Installer pas à pas</h2>
          <p class="intro">
            L’extension n’est pas sur le Chrome Web Store : elle s’installe directement, sur un ordinateur, avec Chrome,
            Edge, Brave, Vivaldi ou Opera. Suivez le guide, cela prend cinq minutes, une seule fois.
          </p>
          <div class="trust">
            <h3>Avant d’installer : ce que l’extension peut faire, et ce qu’elle ne peut pas faire</h3>
            <div class="trust-grid">
              <div>
                <p class="trust-label">Elle peut</p>
                <ul class="trust-list yes">{can.map((c) => <li>{c}</li>)}</ul>
              </div>
              <div>
                <p class="trust-label">Elle ne peut pas</p>
                <ul class="trust-list no">{cannot.map((c) => <li>{c}</li>)}</ul>
              </div>
            </div>
            <p class="trust-foot">
              Chrome le garantit : l’extension n’a reçu l’autorisation d’accéder qu’à melenchon2027.fr. Son{" "}
              <a href={repoUrl}>code source est public</a>, chacun peut le vérifier.
              {zipSha256 && <> Empreinte SHA-256 du fichier : <code>{zipSha256}</code></>}
            </p>
          </div>

          <ol class="tuto">
